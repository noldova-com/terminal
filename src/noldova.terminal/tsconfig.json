{
  "extends": "../../tsconfig-base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../../_build/compiled",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/api/window.ts",
    "src/api/window.d.ts"
  ]
}
